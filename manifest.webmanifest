{
  "name": "ctrl.app",
  "short_name": "ctrl",
  "description": "Un whiteboard infini pour ne plus perdre ses idées.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#141415",
  "theme_color": "#141415",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Nouvelle idée", "short_name": "Idée", "url": "./?new=text", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Nouvelle tâche", "short_name": "Tâche", "url": "./?new=task", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
